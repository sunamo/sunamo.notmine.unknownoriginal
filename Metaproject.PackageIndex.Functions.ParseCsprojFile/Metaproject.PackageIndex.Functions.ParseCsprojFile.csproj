<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <Authors>cdorst</Authors>
    <Description>Helper for parsing project information from a .csproj file</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>CDorst.Metaproject.PackageIndex.Functions.ParseCsprojFile</PackageId>
    <Version>1.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SunamoExceptions" Version="*" />
    <PackageReference Include="SunamoShared" Version="*" />
    <ProjectReference Include="..\Metaproject.PackageIndex.Structures.PackageProject\Metaproject.PackageIndex.Structures.PackageProject.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);ASYNC;Metaproject.PackageIndex.Functions.ParseCsprojFile;Metaproject.PackageIndex.Functions.ParseCsprojFile.csproj</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants);ASYNC;Metaproject.PackageIndex.Functions.ParseCsprojFile;Metaproject.PackageIndex.Functions.ParseCsprojFile.csproj</DefineConstants>
  </PropertyGroup>
</Project>