<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <Authors>cdorst</Authors>
    <Description>Helper for parsing project information from .csproj files under a directory</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>CDorst.Metaproject.PackageIndex.Functions.ParseCsprojFiles</PackageId>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CDorst.Metaproject.PackageIndex.Functions.ParseCsprojFile" Version="1.0.1" />
    <PackageReference Include="CDorst.Metaproject.PackageIndex.Structures.PackageProject" Version="2.0.0" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);ASYNC;Metaproject.PackageIndex.Functions.ParseCsprojFiles;Metaproject.PackageIndex.Functions.ParseCsprojFiles.csproj</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants);ASYNC;Metaproject.PackageIndex.Functions.ParseCsprojFiles;Metaproject.PackageIndex.Functions.ParseCsprojFiles.csproj</DefineConstants>
  </PropertyGroup>
</Project>